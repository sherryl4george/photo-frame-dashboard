# Copy to /opt/photoframe/config/secrets.env on the server (mode 600; never commit the real one).
# systemd loads it into the service (EnvironmentFile=). One KEY=value per line, no quotes needed if the values
# are letters and digits only (make passwords with: openssl rand -hex 24).
DASHBOARD_KEY=a-long-random-string-of-letters-and-digits
# MQTT (Home Assistant's Mosquitto add-on): a login made just for the frame, not Zigbee2MQTT's.
# MQTT_HOST=<broker-ip>
# MQTT_USER=photoframe
# MQTT_PASS=
# Home Assistant long-lived access token (of a non-admin user made for the dashboard).
# HA_TOKEN=
